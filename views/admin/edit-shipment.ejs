<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="admin-page">

  <!-- =========================
       PAGE HEADER
  ========================== -->

  <section class="admin-page-header">

    <div class="container">

      <div class="admin-header-content reveal-up">

        <div>

          <span class="section-subtitle">
            SHIPMENT MANAGEMENT
          </span>

          <h1>Edit Shipment</h1>

          <p>
            Update shipment information while keeping the tracking number
            unchanged.
          </p>

        </div>

        <div class="admin-header-actions">

          <a
            href="/admin/shipment/<%= shipment._id %>"
            class="btn-outline"
          >
            <i class="fa-solid fa-arrow-left"></i>
            Shipment Details
          </a>

          <a
            href="/admin"
            class="btn-outline"
          >
            <i class="fa-solid fa-gauge-high"></i>
            Dashboard
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       EDIT FORM
  ========================== -->

  <section class="admin-form-section section-padding">

    <div class="container">

      <form
        action="/admin/edit-shipment/<%= shipment._id %>"
        method="POST"
        class="admin-form-card reveal-up"
      >


        <!-- =========================
             TRACKING INFORMATION
        ========================== -->

        <div class="admin-form-heading">

          <span class="section-subtitle">
            TRACKING INFORMATION
          </span>

          <h2>Shipment #<%= shipment.trackingNumber %></h2>

          <p>
            The tracking number is automatically generated and cannot be
            changed.
          </p>

        </div>


        <div class="admin-form-section-title">

          <i class="fa-solid fa-barcode"></i>

          <h3>Tracking Number</h3>

        </div>


        <div class="tracking-display-field">

          <div class="tracking-display-icon">
            <i class="fa-solid fa-barcode"></i>
          </div>

          <div class="tracking-display-content">

            <span>TRACKING NUMBER</span>

            <strong>
              <%= shipment.trackingNumber %>
            </strong>

          </div>

          <div class="tracking-locked">

            <i class="fa-solid fa-lock"></i>

            Locked

          </div>

        </div>


        <!-- =========================
             STATUS
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-truck-fast"></i>

          <h3>Shipment Status</h3>

        </div>


        <div class="admin-form-grid">

          <div class="admin-form-group">

            <label for="status">
              Current Status
            </label>

            <select
              id="status"
              name="status"
              required
            >

              <option
                value="Pending"
                <%= shipment.status === "Pending" ? "selected" : "" %>
              >
                Pending
              </option>

              <option
                value="Picked Up"
                <%= shipment.status === "Picked Up" ? "selected" : "" %>
              >
                Picked Up
              </option>

              <option
                value="In Transit"
                <%= shipment.status === "In Transit" ? "selected" : "" %>
              >
                In Transit
              </option>

              <option
                value="Out for Delivery"
                <%= shipment.status === "Out for Delivery" ? "selected" : "" %>
              >
                Out for Delivery
              </option>

              <option
                value="Delivered"
                <%= shipment.status === "Delivered" ? "selected" : "" %>
              >
                Delivered
              </option>

              <option
                value="Cancelled"
                <%= shipment.status === "Cancelled" ? "selected" : "" %>
              >
                Cancelled
              </option>

            </select>

          </div>

        </div>


        <!-- =========================
             SENDER
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-user"></i>

          <h3>Sender Information</h3>

        </div>


        <div class="admin-form-grid">

          <div class="admin-form-group">

            <label for="senderName">
              Sender Name
            </label>

            <input
              type="text"
              id="senderName"
              name="senderName"
              value="<%= shipment.senderName || '' %>"
              placeholder="Sender full name"
              required
            />

          </div>


          <div class="admin-form-group">

            <label for="senderEmail">
              Sender Email
            </label>

            <input
              type="email"
              id="senderEmail"
              name="senderEmail"
              value="<%= shipment.senderEmail || '' %>"
              placeholder="sender@example.com"
            />

          </div>


          <div class="admin-form-group">

            <label for="senderPhone">
              Sender Phone
            </label>

            <input
              type="tel"
              id="senderPhone"
              name="senderPhone"
              value="<%= shipment.senderPhone || '' %>"
              placeholder="+234..."
            />

          </div>


          <div class="admin-form-group admin-form-group-full">

            <label for="senderAddress">
              Sender Address
            </label>

            <input
              type="text"
              id="senderAddress"
              name="senderAddress"
              value="<%= shipment.senderAddress || '' %>"
              placeholder="Full sender address"
            />

          </div>

        </div>


        <!-- =========================
             RECIPIENT
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-location-dot"></i>

          <h3>Recipient Information</h3>

        </div>


        <div class="admin-form-grid">

          <div class="admin-form-group">

            <label for="receiverName">
              Recipient Name
            </label>

            <input
              type="text"
              id="receiverName"
              name="receiverName"
              value="<%= shipment.receiverName || '' %>"
              placeholder="Recipient full name"
              required
            />

          </div>


          <div class="admin-form-group">

            <label for="receiverEmail">
              Recipient Email
            </label>

            <input
              type="email"
              id="receiverEmail"
              name="receiverEmail"
              value="<%= shipment.receiverEmail || '' %>"
              placeholder="recipient@example.com"
            />

          </div>


          <div class="admin-form-group">

            <label for="receiverPhone">
              Recipient Phone
            </label>

            <input
              type="tel"
              id="receiverPhone"
              name="receiverPhone"
              value="<%= shipment.receiverPhone || '' %>"
              placeholder="+234..."
            />

          </div>


          <div class="admin-form-group admin-form-group-full">

            <label for="receiverAddress">
              Recipient Address
            </label>

            <input
              type="text"
              id="receiverAddress"
              name="receiverAddress"
              value="<%= shipment.receiverAddress || '' %>"
              placeholder="Full recipient address"
            />

          </div>

        </div>


        <!-- =========================
             ROUTE
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-route"></i>

          <h3>Shipment Route</h3>

        </div>


        <div class="admin-form-grid">

          <div class="admin-form-group">

            <label for="origin">
              Origin
            </label>

            <input
              type="text"
              id="origin"
              name="origin"
              value="<%= shipment.origin || '' %>"
              placeholder="Lagos, Nigeria"
              required
            />

          </div>


          <div class="admin-form-group">

            <label for="destination">
              Destination
            </label>

            <input
              type="text"
              id="destination"
              name="destination"
              value="<%= shipment.destination || '' %>"
              placeholder="London, United Kingdom"
              required
            />

          </div>

        </div>


        <!-- =========================
             PACKAGE
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-box"></i>

          <h3>Package Information</h3>

        </div>


        <div class="admin-form-grid">

          <div class="admin-form-group">

            <label for="shipmentType">
              Service Type
            </label>

            <select
              id="shipmentType"
              name="shipmentType"
              required
            >

              <option
                value="Air Freight"
                <%= shipment.shipmentType === "Air Freight" ? "selected" : "" %>
              >
                Air Freight
              </option>

              <option
                value="Sea/Ocean Freight"
                <%= shipment.shipmentType === "Sea/Ocean Freight" ? "selected" : "" %>
              >
                Sea/Ocean Freight
              </option>

              <option
                value="Road Transportation"
                <%= shipment.shipmentType === "Road Transportation" ? "selected" : "" %>
              >
                Road Transportation
              </option>

              <option
                value="Diplomatic Logistics"
                <%= shipment.shipmentType === "Diplomatic Logistics" ? "selected" : "" %>
              >
                Diplomatic Logistics
              </option>

              <option
                value="Warehousing"
                <%= shipment.shipmentType === "Warehousing" ? "selected" : "" %>
              >
                Warehousing
              </option>

              <option
                value="Packaging & Storage"
                <%= shipment.shipmentType === "Packaging & Storage" ? "selected" : "" %>
              >
                Packaging & Storage
              </option>

            </select>

          </div>


          <div class="admin-form-group">

            <label for="packageType">
              Package Type
            </label>

            <input
              type="text"
              id="packageType"
              name="packageType"
              value="<%= shipment.packageType || '' %>"
              placeholder="Box, Envelope, Pallet..."
            />

          </div>


          <div class="admin-form-group">

            <label for="weight">
              Weight
            </label>

            <input
              type="text"
              id="weight"
              name="weight"
              value="<%= shipment.weight || '' %>"
              placeholder="25 kg"
            />

          </div>


          <div class="admin-form-group">

            <label for="quantity">
              Quantity
            </label>

            <input
              type="number"
              id="quantity"
              name="quantity"
              min="1"
              value="<%= shipment.quantity || 1 %>"
            />

          </div>


          <div class="admin-form-group">

            <label for="estimatedDelivery">
              Estimated Delivery
            </label>

            <input
              type="date"
              id="estimatedDelivery"
              name="estimatedDelivery"
              value="<%= shipment.estimatedDelivery ? new Date(shipment.estimatedDelivery).toISOString().split('T')[0] : '' %>"
            />

          </div>

        </div>


        <!-- =========================
             ORDER DETAILS
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-file-lines"></i>

          <h3>Order Details</h3>

        </div>


        <div class="admin-form-group">

          <label for="orderDetails">
            Order Details
          </label>

          <textarea
            id="orderDetails"
            name="orderDetails"
            rows="7"
            placeholder="Enter additional information about this shipment..."
          ><%= shipment.orderDetails || '' %></textarea>

          <small>
            Update special instructions, package information, customer
            requests, handling instructions or other relevant details.
          </small>

        </div>


        <!-- =========================
             ADMIN NOTES
        ========================== -->

        <div class="admin-form-section-title">

          <i class="fa-solid fa-note-sticky"></i>

          <h3>Admin Notes</h3>

        </div>


        <div class="admin-form-group">

          <label for="adminNotes">
            Internal Notes
          </label>

          <textarea
            id="adminNotes"
            name="adminNotes"
            rows="5"
            placeholder="Add private notes about this shipment..."
          ><%= shipment.adminNotes || '' %></textarea>

          <small>
            These notes are for internal shipment management.
          </small>

        </div>


        <!-- =========================
             ACTIONS
        ========================== -->

        <div class="admin-form-actions">

          <a
            href="/admin/shipment/<%= shipment._id %>"
            class="btn-outline"
          >
            <i class="fa-solid fa-xmark"></i>
            Cancel
          </a>


          <button
            type="submit"
            class="btn-primary"
          >

            <i class="fa-solid fa-floppy-disk"></i>

            Save Changes

          </button>

        </div>

      </form>

    </div>

  </section>

</main>


<%- include('../partials/translation') %>

<%- include('../partials/footer') %>