<%- include('partials/head') %> <%- include('partials/header') %>

<main class="services-page-wrapper">
  <!-- =========================
       SERVICES PAGE HEADER
  ========================== -->
  <section class="page-header about-page-header services-page-header">
    <div class="container page-header-content reveal-up">
      <span class="page-header-eyebrow">DASHWAY SERVICES</span>

      <h1>
        Logistics Solutions
        <span>Built Around You.</span>
      </h1>

      <p class="page-header-description">
        Comprehensive logistics solutions tailored to your unique shipping
        needs, wherever your shipment needs to go.
      </p>

      <p class="breadcrumb">
        <a href="/">Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>Our Services</span>
      </p>
    </div>
  </section>
  <!-- =========================
       MAIN SERVICES
  ========================== -->
  <section class="services-section section-padding">
    <div class="container">
      <div class="section-header text-center reveal-up">
        <span class="section-subtitle">WHAT WE OFFER</span>

        <h2>
          Comprehensive Logistics
          <span>Solutions</span>
        </h2>

        <p>
          From air freight to specialized diplomatic services, we provide
          end-to-end logistics solutions designed to meet your unique shipping
          requirements with efficiency and reliability.
        </p>
      </div>

      <div class="services-grid">
        <!-- AIR FREIGHT -->
        <article class="service-card reveal-left">
          <div class="service-img-wrapper">
            <img
              src="/images/air-freight.jpg"
              alt="Air Freight"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-plane"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-plane"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">01</span>

            <h3>Air Freight</h3>

            <p>
              Sea Flow Courier, as an IATA-endorsed air forwarder, offers
              professional and reliable global air-freight solutions.
            </p>

            <div class="service-tags">
              <span class="tag">Express Delivery</span>
              <span class="tag">Global Coverage</span>
              <span class="tag">Priority Shipping</span>
            </div>
          </div>
        </article>

        <!-- OCEAN FREIGHT -->
        <article class="service-card reveal-right">
          <div class="service-img-wrapper">
            <img
              src="/images/ocean-freight.jpg"
              alt="Sea/Ocean Freight"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-ship"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-ship"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">02</span>

            <h3>Sea/Ocean Freight</h3>

            <p>
              We offer international ocean freight shipping import and export
              services. Full container loads (FCL) or less than container (LCL)
              shipments.
            </p>

            <div class="service-tags">
              <span class="tag">FCL Shipping</span>
              <span class="tag">LCL Options</span>
              <span class="tag">Port to Door</span>
            </div>
          </div>
        </article>

        <!-- ROAD TRANSPORT -->
        <article class="service-card reveal-left">
          <div class="service-img-wrapper">
            <img
              src="/images/road-transport.jpg"
              alt="Road Transportation"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-truck"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-truck"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">03</span>

            <h3>Road Transportation</h3>

            <p>
              Highly experienced and dependable, Sea Flow Courier is a trusted
              partner in domestic road transportation offering expert logistics
              solutions.
            </p>

            <div class="service-tags">
              <span class="tag">Same-Day Delivery</span>
              <span class="tag">Last Mile</span>
              <span class="tag">Regional Coverage</span>
            </div>
          </div>
        </article>

        <!-- DIPLOMATIC -->
        <article class="service-card reveal-right">
          <div class="service-img-wrapper">
            <img
              src="/images/diplomatic-bag.jpg"
              alt="Diplomatic Bag and Secure Logistics"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-user-shield"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-user-shield"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">04</span>

            <h3>Diplomatic Bag & Secure Logistics</h3>

            <p>
              Send and receive mail and equipment around the world securely with
              complete confidence via vetted diplomatic channels.
            </p>

            <div class="service-tags">
              <span class="tag">High Security</span>
              <span class="tag">Confidential</span>
              <span class="tag">Diplomatic Channels</span>
            </div>
          </div>
        </article>

        <!-- WAREHOUSING -->
        <article class="service-card reveal-left">
          <div class="service-img-wrapper">
            <img
              src="/images/warehousing.jpg"
              alt="Warehousing"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-warehouse"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-warehouse"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">05</span>

            <h3>Warehousing</h3>

            <p>
              Dedicated and specialized storage solutions supported by
              state-of-the-art technology as part of our full suite of warehouse
              services.
            </p>

            <div class="service-tags">
              <span class="tag">Inventory Management</span>
              <span class="tag">Distribution</span>
              <span class="tag">Fulfillment</span>
            </div>
          </div>
        </article>

        <!-- PACKAGING -->
        <article class="service-card reveal-right">
          <div class="service-img-wrapper">
            <img
              src="/images/packaging-storage.jpg"
              alt="Packaging and Storage"
              onerror="
                this.onerror = null;
                this.parentElement.classList.add('img-fallback');
              "
            />

            <div class="fallback-overlay">
              <i class="fa-solid fa-boxes-stacked"></i>
            </div>

            <div class="service-image-overlay"></div>

            <div class="service-card-icon">
              <i class="fa-solid fa-boxes-stacked"></i>
            </div>
          </div>

          <div class="service-content">
            <span class="service-number">06</span>

            <h3>Packaging & Storage</h3>

            <p>
              Whether your shipments comprise raw materials, electronics, or
              finished goods, we offer custom storage solutions and full cargo
              insurance.
            </p>

            <div class="service-tags">
              <span class="tag">Custom Packaging</span>
              <span class="tag">Secure Storage</span>
              <span class="tag">Cargo Insurance</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================
       GLOBAL NETWORK
  ========================== -->
  <section class="network-section section-padding">
    <div class="container">
      <div class="network-grid">
        <!-- IMAGE -->
        <div class="network-image-wrapper reveal-left">
          <img
            src="/images/global-network.jpg"
            alt="DashWay global logistics network"
            onerror="
              this.style.display = 'none';
              this.parentElement.classList.add('network-img-fallback');
            "
          />

          <div class="network-fallback">
            <i class="fa-solid fa-globe"></i>
          </div>

          <div class="network-image-badge">
            <strong>160+</strong>
            <span>Countries</span>
          </div>
        </div>

        <!-- CONTENT -->
        <div class="network-content reveal-right">
          <span class="section-subtitle">GLOBAL PRESENCE</span>

          <h2>
            A network that keeps
            <span>the world moving.</span>
          </h2>

          <p class="network-description">
            Our clients overseas require a global and locally responsive secure
            support network. We provide translation and interpretation into more
            than 60 languages by experts who understand legal and business
            environments.
          </p>

          <div class="network-features">
            <div class="network-feature reveal-up">
              <div class="network-feature-icon">
                <i class="fa-solid fa-globe"></i>
              </div>

              <div>
                <h4>Global Coverage</h4>
                <p>160+ countries worldwide</p>
              </div>
            </div>

            <div class="network-feature reveal-up">
              <div class="network-feature-icon">
                <i class="fa-solid fa-language"></i>
              </div>

              <div>
                <h4>Translation Services</h4>
                <p>60+ languages supported</p>
              </div>
            </div>

            <div class="network-feature reveal-up">
              <div class="network-feature-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>
                <h4>Security Vetting</h4>
                <p>National security standards</p>
              </div>
            </div>

            <div class="network-feature reveal-up">
              <div class="network-feature-icon">
                <i class="fa-solid fa-building"></i>
              </div>

              <div>
                <h4>Diplomatic Offices</h4>
                <p>250+ locations served</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================
       ADVANTAGES
  ========================== -->
  <section class="advantages-section section-padding">
    <div class="container">
      <div class="section-header text-center reveal-up">
        <span class="section-subtitle">OUR ADVANTAGES</span>

        <h2>
          Why Choose Our
          <span>Services?</span>
        </h2>

        <p>
          With decades of experience in the logistics industry, we offer
          reliable, secure and efficient shipping solutions designed around your
          requirements.
        </p>
      </div>

      <div class="advantages-grid">
        <article class="advantage-card reveal-left">
          <div class="icon-circle big-icon">
            <i class="fa-solid fa-truck-fast"></i>
          </div>

          <span class="advantage-number">01</span>

          <h3>Fast & Reliable</h3>

          <p>
            Expedited shipping services ensuring cargo arrives on time with
            end-to-end tracking.
          </p>
        </article>

        <article class="advantage-card reveal-up">
          <div class="icon-circle big-icon">
            <i class="fa-solid fa-lock"></i>
          </div>

          <span class="advantage-number">02</span>

          <h3>Secure Handling</h3>

          <p>
            Advanced security protocols protecting your high-value shipments
            worldwide.
          </p>
        </article>

        <article class="advantage-card reveal-right">
          <div class="icon-circle big-icon">
            <i class="fa-solid fa-globe"></i>
          </div>

          <span class="advantage-number">03</span>

          <h3>Global Network</h3>

          <p>
            Seamless international logistics backed by localized customs and
            route expertise.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================
       SERVICES CTA
  ========================== -->
  <section class="services-cta-section">
    <div class="container">
      <div class="services-cta reveal-up">
        <div class="services-cta-content">
          <span class="section-subtitle"> READY TO SHIP? </span>

          <h2>
            Let's move your
            <span>shipment forward.</span>
          </h2>

          <p>
            Tell us what you need and our logistics team will help you find the
            right solution.
          </p>
        </div>

        <div class="services-cta-action">
          <a href="/contact" class="btn-outline">
            Get A Quote
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/translation') %> <%- include('partials/footer') %>
