<%- include('partials/head') %> <%- include('partials/header') %>

<!-- =========================================
     PAGE HEADER
========================================= -->
<section class="page-header about-page-header">
  <div class="container page-header-content reveal-up">
    <span class="page-header-eyebrow">ABOUT DASHWAY</span>

    <h1>
      Moving What Matters.
      <span>Delivering What Counts.</span>
    </h1>

    <p class="breadcrumb">
      <a href="/">Home</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>About Us</span>
    </p>
  </div>
</section>

<!-- =========================================
     COMPANY PROFILE
========================================= -->
<section class="about-profile section-padding">
  <div class="container">
    <div class="about-profile-grid">
      <!-- Left -->
      <div class="about-profile-content reveal-left">
        <span class="section-subtitle"> COMPANY PROFILE </span>

        <h2>
          Logistics built around
          <span>speed, safety and trust.</span>
        </h2>

        <p>
          DashWay is a modern logistics and delivery company focused on
          providing dependable transportation solutions for individuals,
          businesses and organizations.
        </p>

        <p>
          From local deliveries to international freight, we combine
          professional service, modern technology and efficient logistics
          processes to make sure your shipment gets where it needs to go, safely
          and on time.
        </p>

        <p>
          Our goal is simple: make logistics easier, more transparent and more
          reliable for every customer we serve.
        </p>

        <div class="about-actions">
          <a href="/contact" class="btn-primary">
            Get In Touch
            <i class="fa-solid fa-arrow-right"></i>
          </a>

          <a href="/services" class="btn-outline"> Explore Services </a>
        </div>
      </div>

      <!-- Right -->
      <div class="about-profile-visual reveal-right">
        <div class="about-image-wrapper">
          <img
            src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1000&q=85"
            alt="DashWay logistics and shipping"
          />

          <div class="about-image-badge">
            <span class="badge-number">24/7</span>
            <span class="badge-text">Logistics Support</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     FOUNDATION
========================================= -->
<section class="foundation-section section-padding">
  <div class="container">
    <div class="section-header text-center reveal-up">
      <span class="section-subtitle"> WHAT DRIVES US </span>

      <h2>Our Foundation</h2>

      <p>
        Built on strong values, clear vision and a commitment to better
        logistics.
      </p>
    </div>

    <div class="foundation-grid">
      <!-- Mission -->
      <article class="foundation-card reveal-left">
        <div class="foundation-image">
          <img
            src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=800&q=85"
            alt="DashWay team working together"
          />
        </div>

        <div class="foundation-body">
          <div class="foundation-icon">
            <i class="fa-solid fa-bullseye"></i>
          </div>

          <h3>Our Mission</h3>

          <p>
            Connecting people, businesses and communities through logistics
            solutions that are fast, dependable and accessible.
          </p>
        </div>
      </article>

      <!-- Vision -->
      <article class="foundation-card reveal-up">
        <div class="foundation-image">
          <img
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=800&q=85"
            alt="Modern logistics office"
          />
        </div>

        <div class="foundation-body">
          <div class="foundation-icon">
            <i class="fa-solid fa-eye"></i>
          </div>

          <h3>Our Vision</h3>

          <p>
            To become a trusted global logistics partner by combining
            innovation, technology and exceptional service.
          </p>
        </div>
      </article>

      <!-- Values -->
      <article class="foundation-card reveal-right">
        <div class="foundation-image">
          <img
            src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=800&q=85"
            alt="DashWay logistics team"
          />
        </div>

        <div class="foundation-body">
          <div class="foundation-icon">
            <i class="fa-solid fa-heart"></i>
          </div>

          <h3>Our Core Values</h3>

          <p>
            Integrity, excellence, accountability, customer focus, innovation
            and respect guide everything we do.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- =========================================
     ACHIEVEMENTS
========================================= -->
<section class="achievements-section">
  <div class="container">
    <div class="section-header text-center reveal-up">
      <span class="section-subtitle"> DASHWAY BY THE NUMBERS </span>

      <h2>Our Achievements</h2>

      <p>Numbers that represent our commitment to reliable logistics.</p>
    </div>

    <div class="achievements-grid">
      <!-- Achievement 1 -->
      <div class="achievement-item reveal-up">
        <div class="achievement-icon">
          <i class="fa-solid fa-box"></i>
        </div>

        <h3><span class="counter-num" data-target="4000">0</span>+</h3>

        <p>Delivered Packages</p>
      </div>

      <!-- Achievement 2 -->
      <div class="achievement-item reveal-up">
        <div class="achievement-icon">
          <i class="fa-solid fa-route"></i>
        </div>

        <h3><span class="counter-num" data-target="2500">0</span>+</h3>

        <p>KM Per Year</p>
      </div>

      <!-- Achievement 3 -->
      <div class="achievement-item reveal-up">
        <div class="achievement-icon">
          <i class="fa-solid fa-calendar-check"></i>
        </div>

        <h3><span class="counter-num" data-target="11">0</span>+</h3>

        <p>Years Experience</p>
      </div>

      <!-- Achievement 4 -->
      <div class="achievement-item reveal-up">
        <div class="achievement-icon">
          <i class="fa-solid fa-users"></i>
        </div>

        <h3><span class="counter-num" data-target="650">0</span>+</h3>

        <p>Happy Clients</p>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     SAFETY & SECURITY
========================================= -->
<section class="security-section section-padding">
  <div class="container">
    <div class="section-header text-center reveal-up">
      <span class="section-subtitle"> WHY TRUST DASHWAY </span>

      <h2>Safety & Security</h2>

      <p>Protecting your shipment from pickup to final delivery.</p>
    </div>

    <div class="security-grid">
      <!-- Safety -->
      <article class="security-card reveal-left">
        <div class="security-card-top">
          <div class="security-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>
            <span class="security-label"> SAFETY FIRST </span>

            <h3>Safety First</h3>
          </div>
        </div>

        <p>
          We understand that every shipment matters. Our logistics processes are
          designed around careful handling, reliable transportation and
          responsible delivery practices.
        </p>

        <p>
          Our team is committed to maintaining high operational standards while
          continuously improving the way we protect customers, employees and
          their shipments.
        </p>

        <div class="security-stats">
          <div class="security-stat">
            <strong>99.9%</strong>
            <span>Safety Focus</span>
          </div>

          <div class="security-stat">
            <strong>24/7</strong>
            <span>Monitoring</span>
          </div>
        </div>
      </article>

      <!-- Security -->
      <article class="security-card reveal-right">
        <div class="security-card-top">
          <div class="security-icon">
            <i class="fa-solid fa-lock"></i>
          </div>

          <div>
            <span class="security-label"> ADVANCED SECURITY </span>

            <h3>Advanced Security</h3>
          </div>
        </div>

        <p>
          DashWay uses modern technology and structured logistics processes to
          help protect customer information, shipments and assets while they are
          in transit or within our logistics network.
        </p>

        <p>
          From shipment tracking to secure handling, we focus on providing
          customers with visibility and confidence throughout the delivery
          journey.
        </p>

        <div class="security-stats">
          <div class="security-stat">
            <strong>256-bit</strong>
            <span>Encryption</span>
          </div>

          <div class="security-stat">
            <strong>ISO</strong>
            <span>Security Standard</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- =========================================
     CTA
========================================= -->
<section class="about-cta-section">
  <div class="container">
    <div class="about-cta reveal-up">
      <div class="about-cta-content">
        <span class="section-subtitle"> READY TO MOVE? </span>

        <h2>
          Ready to experience
          <span>DashWay?</span>
        </h2>

        <p>
          Let us handle your shipment with the speed, safety and reliability
          your business deserves.
        </p>
      </div>

      <div class="about-cta-actions">
        <a href="/contact" class="btn-primary">
          Get Free Quote
          <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a href="/services" class="btn-outline"> Our Services </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/translation') %> <%- include('partials/footer') %>
