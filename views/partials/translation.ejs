<!-- Translation Widget -->
<div class="translation-widget" id="translationWidget">
  <button
    type="button"
    class="translation-toggle"
    id="translationToggle"
    aria-expanded="false"
    aria-label="Change language"
  >
    <span class="translation-flag" id="translationFlag"> 🇬🇧 </span>

    <span id="currentLanguage"> EN </span>

    <i class="fa-solid fa-chevron-up"></i>
  </button>

  <div class="translation-menu" id="translationMenu">
    <button
      type="button"
      class="language-option"
      data-lang="en"
      data-flag="🇬🇧"
      data-name="EN"
    >
      <span>🇬🇧</span>
      <span>English</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="fr"
      data-flag="🇫🇷"
      data-name="FR"
    >
      <span>🇫🇷</span>
      <span>Français</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="es"
      data-flag="🇪🇸"
      data-name="ES"
    >
      <span>🇪🇸</span>
      <span>Español</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="de"
      data-flag="🇩🇪"
      data-name="DE"
    >
      <span>🇩🇪</span>
      <span>Deutsch</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="pt"
      data-flag="🇵🇹"
      data-name="PT"
    >
      <span>🇵🇹</span>
      <span>Português</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="zh-CN"
      data-flag="🇨🇳"
      data-name="ZH"
    >
      <span>🇨🇳</span>
      <span>中文</span>
    </button>

    <button
      type="button"
      class="language-option"
      data-lang="ja"
      data-flag="🇯🇵"
      data-name="JA"
    >
      <span>🇯🇵</span>
      <span>日本語</span>
    </button>
  </div>
</div>

<!-- Google Translate -->
<div id="google_translate_element" class="google-translate-hidden"></div>
