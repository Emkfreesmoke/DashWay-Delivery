<header class="site-header">
  <!-- Top Contact Bar -->
  <div class="header-top">
    <div class="header-top-inner">
      <div class="header-top-item">
        <i class="fa-regular fa-clock"></i>
        <span>Open 24/7 for Global Logistics</span>
      </div>

      <div class="header-top-item">
        <i class="fa-regular fa-envelope"></i>
        <a href="mailto:contact@dashway.com"> contact@dashway.com </a>
      </div>
    </div>
  </div>

  <!-- Main Header -->
  <div class="header-main">
    <div class="header-main-inner">
      <!-- Logo -->
      <a href="/" class="header-logo">
        <img
          src="/images/dashway-logo2.jpeg"
          alt="DashWay"
          style="
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
          "
        />
        <span class="header-brand-text"
          ><strong>
            <span class="brand-white">Dash</span
            ><span class="brand-orange">way</span></strong
          ><small>Delivery</small></span
        >
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav">
        <a href="/" class="nav-link"> Home </a>

        <a href="/about" class="nav-link"> About </a>

        <!-- Services -->
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-toggle">
            Services
            <i class="fa-solid fa-chevron-down"></i>
          </button>

          <div class="nav-dropdown-menu">
            <a href="/services">
              <i class="fa-solid fa-ship"></i>
              <span>Sea/Ocean Freight</span>
            </a>

            <a href="/service">
              <i class="fa-solid fa-truck"></i>
              <span>Road Transportation</span>
            </a>

            <a href="/service">
              <i class="fa-solid fa-plane"></i>
              <span>Air Freight</span>
            </a>

            <a href="/services">
              <i class="fa-solid fa-warehouse"></i>
              <span>Warehousing</span>
            </a>

            <a href="/services">
              <i class="fa-solid fa-box"></i>
              <span>Packaging &amp; Storage</span>
            </a>

            <a href="/service">
              <i class="fa-solid fa-user-tie"></i>
              <span>Diplomatic Services</span>
            </a>
          </div>
        </div>

        <a href="/track-shipment" class="nav-link"> Track Shipment </a>

        <a href="/contact" class="nav-link"> Contact </a>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Search -->
        <button
          type="button"
          class="header-icon-btn"
          id="searchToggle"
          aria-label="Search"
        >
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <!-- Theme Toggle -->
        <button
          type="button"
          class="header-icon-btn theme-toggle"
          id="themeToggle"
          aria-label="Toggle dark mode"
        >
          <i class="fa-solid fa-moon"></i>
        </button>

        <!-- Mobile Menu -->
        <button
          type="button"
          class="menu-toggle"
          id="menuToggle"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Search Box -->
  <div class="header-search" id="headerSearch">
    <form action="/search" method="GET">
      <input
        type="search"
        name="q"
        placeholder="Search DashWay..."
        autocomplete="off"
      />

      <button type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-inner">
      <!-- About -->
      <a href="/about" class="mobile-nav-link">
        <span>About</span>
      </a>

      <!-- Services Accordion -->
      <div class="mobile-services">
        <button
          type="button"
          class="mobile-nav-link mobile-services-toggle"
          id="mobileServicesToggle"
          aria-expanded="false"
        >
          <span>Services</span>

          <i class="fa-solid fa-chevron-down"></i>
        </button>

        <div class="mobile-services-content" id="mobileServicesContent">
          <a href="/service">
            <i class="fa-solid fa-ship"></i>
            <span>Sea/Ocean Freight</span>
          </a>

          <a href="/service">
            <i class="fa-solid fa-truck"></i>
            <span>Road Transportation</span>
          </a>

          <a href="/service">
            <i class="fa-solid fa-plane"></i>
            <span>Air Freight</span>
          </a>

          <a href="/service">
            <i class="fa-solid fa-warehouse"></i>
            <span>Warehousing</span>
          </a>

          <a href="/service">
            <i class="fa-solid fa-box"></i>
            <span>Packaging &amp; Storage</span>
          </a>

          <a href="/service">
            <i class="fa-solid fa-user-tie"></i>
            <span>Diplomatic Services</span>
          </a>
        </div>
      </div>

      <!-- Track -->
      <a href="/track-shipment" class="mobile-nav-link">
        <span>Track Shipment</span>
      </a>

      <!-- Contact -->
      <a href="/contact" class="mobile-nav-link">
        <span>Contact</span>
      </a>

      <!-- Get Quote -->
      <a href="/contact" class="mobile-quote-btn"> Get Quote </a>
    </div>
  </div>
</header>
