<%- include('partials/head') %> <%- include('partials/header') %>

<!-- =========================
     CONTACT PAGE HEADER
========================= -->
<section class="page-header contact-page-header">
  <div class="container page-header-content reveal-up">
    <span class="page-header-eyebrow">CONTACT DASHWAY</span>

    <h1>
      Let's Move Your
      <span>Next Shipment.</span>
    </h1>

    <p class="page-header-description">
      Have a question, need a quote, or want help with your shipment? Our team
      is ready to assist you.
    </p>

    <p class="breadcrumb">
      <a href="/">Home</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>Contact Us</span>
    </p>
  </div>
</section>

<!-- =========================
     CONTACT SECTION
========================= -->
<section class="contact-section section-padding">
  <div class="container">
    <div class="contact-grid">
      <!-- CONTACT INFORMATION -->
      <div class="contact-info-wrapper reveal-left">
        <span class="section-subtitle">GET IN TOUCH</span>

        <h2>
          We're here to assist you with
          <span>all your logistics needs.</span>
        </h2>

        <p class="contact-desc">
          Have questions about shipping rates, package tracking, or enterprise
          solutions? Reach out to our team directly and we'll be happy to help.
        </p>

        <div class="info-cards">
          <!-- ADDRESS -->
          <div class="info-card reveal-up">
            <div class="icon-box">
              <i class="fa-solid fa-location-dot"></i>
            </div>

            <div class="info-details">
              <span class="info-label">OUR LOCATION</span>
              <h4>Head Office</h4>
              <p>DashWay Headquarters, Global Logistics Zone, Way 102</p>
            </div>
          </div>

          <!-- PHONE -->
          <div class="info-card reveal-up">
            <div class="icon-box">
              <i class="fa-solid fa-phone"></i>
            </div>

            <div class="info-details">
              <span class="info-label">CALL US</span>
              <h4>Phone</h4>
              <p>
                +1 (800) 555-0199<br />
                +1 (800) 555-0122
              </p>
            </div>
          </div>

          <!-- EMAIL -->
          <div class="info-card reveal-up">
            <div class="icon-box">
              <i class="fa-solid fa-envelope"></i>
            </div>

            <div class="info-details">
              <span class="info-label">SEND US AN EMAIL</span>
              <h4>Email</h4>
              <p>contact@dashway-delivery.com</p>
            </div>
          </div>

          <!-- HOURS -->
          <div class="info-card reveal-up">
            <div class="icon-box">
              <i class="fa-solid fa-clock"></i>
            </div>

            <div class="info-details">
              <span class="info-label">WHEN WE'RE AVAILABLE</span>
              <h4>Working Hours</h4>
              <p>
                Mon - Sat: 8:00 AM - 8:00 PM
                <br />
                24/7 Online Support
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CONTACT FORM -->
      <div class="contact-form-wrapper reveal-right">
        <div class="contact-form-card">
          <div class="form-card-header">
            <span class="form-icon">
              <i class="fa-solid fa-paper-plane"></i>
            </span>

            <div>
              <span class="section-subtitle">SEND A MESSAGE</span>
              <h3>How can we help?</h3>
            </div>
          </div>

          <p class="form-intro">
            Fill out the form below and our team will get back to you as soon as
            possible.
          </p>

          <form action="/contact" method="POST" class="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name"> Full Name </label>

                <div class="input-wrapper">
                  <i class="fa-solid fa-user"></i>

                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="John Doe"
                    autocomplete="name"
                    required
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="email"> Email Address </label>

                <div class="input-wrapper">
                  <i class="fa-solid fa-envelope"></i>

                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="john@example.com"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="subject"> Subject / Service Type </label>

              <div class="input-wrapper">
                <i class="fa-solid fa-box"></i>

                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="Tracking Inquiry, Quote Request..."
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="message"> Message </label>

              <div class="textarea-wrapper">
                <i class="fa-solid fa-message"></i>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Tell us how we can help..."
                  required
                ></textarea>
              </div>
            </div>

            <button type="submit" class="btn-primary contact-submit">
              <span>Send Message</span>
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================
     MAP SECTION
========================= -->
<section class="map-section">
  <div class="map-header reveal-up">
    <div class="container">
      <span class="section-subtitle">FIND US</span>
      <h2>Our Location</h2>
    </div>
  </div>

  <div class="map-wrapper reveal-up">
    <iframe
      src="https://maps.google.com/maps?q=2166+Wright+Ave,+La+Verne,+Los+Angeles,+CA+91750,+USA&t=&z=15&ie=UTF8&iwloc=&output=embed"
      width="100%"
      height="400"
      style="border: 0"
      allowfullscreen=""
      loading="lazy"
    ></iframe>
  </div>
</section>

<!-- =========================
     CONTACT CTA
========================= -->
<section class="contact-cta-section">
  <div class="container">
    <div class="contact-cta reveal-up">
      <div class="contact-cta-content">
        <span class="section-subtitle">NEED IMMEDIATE HELP?</span>

        <h2>
          Your shipment is
          <span>our priority.</span>
        </h2>

        <p>
          Whether you're moving a single package or managing international
          freight, DashWay is ready to help.
        </p>
      </div>

      <div class="contact-cta-action">
        <a href="/service" class="btn-outline">
          Explore Services
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/translation') %> <%- include('partials/footer') %>
